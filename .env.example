# Asaas production API key (NEVER put this in index.html)
ASAAS_API_KEY=cole_sua_chave_asaas_aqui

# Redis database connected to Vercel through the Marketplace
KV_REST_API_URL
# Também aceita UPSTASH_REDIS_REST_URL=https://...
KV_REST_API_TOKEN
# Também aceita UPSTASH_REDIS_REST_TOKEN=...

# Vercel Blob public store token for product images
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Admin credentials (server-side only)
ADMIN_USER=admin
ADMIN_PASSWORD=troque_por_uma_senha_forte
ADMIN_SESSION_SECRET=gere_uma_string_aleatoria_com_32_ou_mais_caracteres

# Token chosen by you when configuring the Asaas webhook.
# Use a random value of at least 32 characters.
ASAAS_WEBHOOK_TOKEN=gere_um_token_aleatorio_com_32_ou_mais_caracteres
